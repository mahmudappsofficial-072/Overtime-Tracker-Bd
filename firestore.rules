rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /overtime_records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /piece_rate_records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /monthly_salary_settings/{yearMonth} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /deduction_records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
